{
  "name": "webq",
  "version": "1.0.0",
  "description": "WebQ - Simple website builder",
  "scripts": {
    "build:css": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css",
    "watch:css": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --watch",
    "build:css:prod": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
